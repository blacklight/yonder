# Yonder environment variables
#
# Copy this file to `.env` and edit it. `yonder` loads `.env` automatically
# (dotenvy) and every `YONDER_*` variable overrides the corresponding
# config.toml value — `YONDER_<SECTION>__<KEY>` with `__` as the nesting
# separator. Database overlays, when present, still take precedence.
# Prefer this file over config.toml for secrets.
# `yonder config list` prints every setting's env-var name.

# Path to the TOML configuration file (default: ./config.toml).
# YONDER_CONFIG=/etc/yonder/config.toml

# Log filter directive — overrides server.log_level when set
# (e.g. "debug", "yonder=debug,sqlx=warn").
# RUST_LOG=info

# Instance identity.
# YONDER_INSTANCE__DOMAIN=example.com
# YONDER_INSTANCE__NAME=My Instance

# Registration mode: open | approval-required | closed
# YONDER_AUTH__REGISTRATION_MODE=open

# Database and Redis connections.
# YONDER_DATABASE__URL=postgres://yonder:yonder@localhost:5432/yonder
# YONDER_REDIS__URL=redis://localhost:6379/0

# Secrets — keep them here rather than in config.toml.
#
# Signing secret for session/token material.
# Generate with: openssl rand -base64 48
# YONDER_AUTH__SECRET_KEY=

# SMTP password for outgoing email ([email] section holds the
# host/port/username/from address).
# YONDER_EMAIL__SMTP_PASSWORD=

# VAPID keys for Web Push notifications.
# YONDER_HTTP__VAPID_PUBLIC_KEY=
# YONDER_HTTP__VAPID_PRIVATE_KEY=

# S3 storage credentials (only when media.backend = "s3").
# YONDER_MEDIA__S3_ACCESS_KEY=
# YONDER_MEDIA__S3_SECRET_KEY=

# Elasticsearch/OpenSearch URL for indexed search.
# YONDER_SEARCH__ELASTICSEARCH_URL=
